# --- Utility functions ---
def display(keys, values):
    for k, v in zip(keys, values):
        print(f"{k}: {v}")
    print("\n")

def isEmpty(rows):
    if len(rows) == 0:
        print("No data is available.\n")

def run(query, commit=False):
    cursor.execute(query)
    if commit:
        db.commit()
    return cursor.fetchall()

